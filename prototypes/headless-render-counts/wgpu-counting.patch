diff -ruN a/src/od_counters.rs b/src/od_counters.rs
--- a/src/od_counters.rs	1970-01-01 01:00:00
+++ b/src/od_counters.rs	2026-10-04 17:50:50
@@ -0,0 +1,562 @@
+//! PROTOTYPE for OpenDrone issue #29 ("Can Bevy render headless on GitHub's Linux runner and
+//! report per-frame render counts?"). NOT part of upstream wgpu. Added to wgpu 29.0.4 by
+//! `prototypes/headless-render-counts/wgpu-counting.patch`.
+//!
+//! Counts what the app asks wgpu to do, at wgpu's public API, so every caller is covered
+//! (Bevy's tracked passes, its raw full-screen passes, compute, uploads). The harness takes a
+//! snapshot once per frame with [`take_frame`].
+//!
+//! Optional GPU-side numbers: when [`install_pipeline_statistics`] was called on a device with
+//! `Features::PIPELINE_STATISTICS_QUERY` (Vulkan and DX12; not Metal), every render pass is
+//! wrapped in a pipeline-statistics query, resolved by [`resolve_pipeline_statistics`].
+
+extern crate std;
+
+use alloc::{string::String, sync::Arc, vec::Vec};
+use core::{
+    cell::Cell,
+    sync::atomic::{AtomicBool, AtomicI64, AtomicU64, Ordering::Relaxed},
+};
+use std::sync::Mutex;
+
+use crate::*;
+
+/// Max render passes per frame that get a pipeline-statistics query.
+pub const MAX_STATS_PASSES: u32 = 512;
+
+macro_rules! frame_counters {
+    ($($(#[$m:meta])* $name:ident),* $(,)?) => {
+        pub(crate) struct Atomics { $(pub(crate) $name: AtomicU64,)* }
+        pub(crate) static C: Atomics = Atomics { $($name: AtomicU64::new(0),)* };
+        /// Per-frame counts (reset by [`take_frame`]).
+        #[derive(Clone, Debug, Default)]
+        #[allow(missing_docs)]
+        pub struct FrameCounts {
+            $($(#[$m])* pub $name: u64,)*
+            /// Live buffer bytes, from the descriptors of buffers not yet dropped or destroyed.
+            pub buffer_bytes_live: i64,
+            /// Live texture bytes (theoretical footprint of every mip, layer and sample).
+            pub texture_bytes_live: i64,
+            pub buffers_live: i64,
+            pub textures_live: i64,
+            /// Every render and compute pass of the frame, in recording order.
+            pub passes: Vec<PassRecord>,
+        }
+        fn take_atomics(out: &mut FrameCounts) {
+            $(out.$name = C.$name.swap(0, Relaxed);)*
+        }
+    };
+}
+
+frame_counters!(
+    render_passes,
+    compute_passes,
+    /// Sum over render passes of the target area (width x height of the attachment).
+    target_pixels,
+    /// Every draw command: direct draws plus each slot of an indirect or multi-draw.
+    draws,
+    draws_direct,
+    draws_indirect,
+    /// `draw*_indirect*` calls (one call can hold many draws).
+    indirect_calls,
+    /// Draws that drew something: direct draws with vertices and instances, plus indirect
+    /// slots whose read-back arguments have both (after GPU culling).
+    draws_nonempty,
+    /// Triangles of direct draws, from the call's arguments.
+    triangles_direct,
+    /// Triangles of indirect draws, from their arguments read back after the frame.
+    triangles_indirect,
+    /// Indirect slots whose arguments couldn't be read back (buffer without `COPY_SRC`).
+    indirect_unread,
+    /// Vertices (or indices) x instances of direct draws.
+    vertices_direct,
+    dispatches,
+    bundles_executed,
+    render_pipelines_created,
+    compute_pipelines_created,
+    shader_modules_created,
+    bind_groups_created,
+    buffers_created,
+    buffer_bytes_created,
+    textures_created,
+    texture_bytes_created,
+    /// Bytes handed to `Queue::write_buffer*` and `Queue::write_texture`.
+    upload_bytes,
+    submits,
+);
+
+static BUFFER_BYTES_LIVE: AtomicI64 = AtomicI64::new(0);
+static TEXTURE_BYTES_LIVE: AtomicI64 = AtomicI64::new(0);
+static BUFFERS_LIVE: AtomicI64 = AtomicI64::new(0);
+static TEXTURES_LIVE: AtomicI64 = AtomicI64::new(0);
+
+/// One render or compute pass.
+#[derive(Clone, Debug, Default)]
+#[allow(missing_docs)]
+pub struct PassRecord {
+    pub label: String,
+    pub compute: bool,
+    pub width: u32,
+    pub height: u32,
+    pub samples: u32,
+    pub color_targets: u32,
+    pub depth: bool,
+    pub draws: u64,
+    pub draws_indirect: u64,
+    pub draws_nonempty: u64,
+    pub triangles_direct: u64,
+    pub triangles_indirect: u64,
+    pub dispatches: u64,
+    /// Slot in the pipeline-statistics query set, if this pass was wrapped in a query.
+    pub stats_slot: Option<u32>,
+    /// GPU pipeline statistics: vertex shader invocations, clipper invocations (triangles that
+    /// reached the clipper), clipper primitives out, fragment shader invocations, compute shader
+    /// invocations. Filled by [`resolve_pipeline_statistics`].
+    pub stats: Option<[u64; 5]>,
+}
+
+static PASSES: Mutex<Vec<PassRecord>> = Mutex::new(Vec::new());
+
+std::thread_local! {
+    static SUPPRESS: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Runs `f` without counting (for the harness's own readback resources).
+pub fn uncounted<R>(f: impl FnOnce() -> R) -> R {
+    SUPPRESS.with(|s| s.set(true));
+    let r = f();
+    SUPPRESS.with(|s| s.set(false));
+    r
+}
+
+#[inline]
+pub(crate) fn on() -> bool {
+    !SUPPRESS.with(|s| s.get())
+}
+
+/// Adds `v` to a per-frame counter, unless counting is suppressed on this thread.
+#[inline]
+pub(crate) fn bump(c: &AtomicU64, v: u64) {
+    if on() {
+        c.fetch_add(v, Relaxed);
+    }
+}
+
+/// Snapshot and reset the per-frame counts (live memory is a running total, not reset).
+pub fn take_frame() -> FrameCounts {
+    let mut out = FrameCounts::default();
+    take_atomics(&mut out);
+    out.buffer_bytes_live = BUFFER_BYTES_LIVE.load(Relaxed);
+    out.texture_bytes_live = TEXTURE_BYTES_LIVE.load(Relaxed);
+    out.buffers_live = BUFFERS_LIVE.load(Relaxed);
+    out.textures_live = TEXTURES_LIVE.load(Relaxed);
+    out.passes = core::mem::take(&mut *PASSES.lock().unwrap());
+    out
+}
+
+// ---- memory guards -------------------------------------------------------------------------
+
+/// Lives inside every counted `Buffer`/`Texture` clone; the last clone dropping (or an explicit
+/// `destroy()`) releases its bytes once.
+#[derive(Debug)]
+pub(crate) struct MemGuard {
+    bytes: i64,
+    texture: bool,
+    released: AtomicBool,
+}
+
+impl MemGuard {
+    pub(crate) fn new(bytes: u64, texture: bool) -> Option<Arc<MemGuard>> {
+        if !on() {
+            return None;
+        }
+        let bytes = bytes as i64;
+        if texture {
+            TEXTURE_BYTES_LIVE.fetch_add(bytes, Relaxed);
+            TEXTURES_LIVE.fetch_add(1, Relaxed);
+            C.textures_created.fetch_add(1, Relaxed);
+            C.texture_bytes_created.fetch_add(bytes as u64, Relaxed);
+        } else {
+            BUFFER_BYTES_LIVE.fetch_add(bytes, Relaxed);
+            BUFFERS_LIVE.fetch_add(1, Relaxed);
+            C.buffers_created.fetch_add(1, Relaxed);
+            C.buffer_bytes_created.fetch_add(bytes as u64, Relaxed);
+        }
+        Some(Arc::new(MemGuard { bytes, texture, released: AtomicBool::new(false) }))
+    }
+
+    pub(crate) fn release(&self) {
+        if self.released.swap(true, Relaxed) {
+            return;
+        }
+        if self.texture {
+            TEXTURE_BYTES_LIVE.fetch_sub(self.bytes, Relaxed);
+            TEXTURES_LIVE.fetch_sub(1, Relaxed);
+        } else {
+            BUFFER_BYTES_LIVE.fetch_sub(self.bytes, Relaxed);
+            BUFFERS_LIVE.fetch_sub(1, Relaxed);
+        }
+    }
+}
+
+impl Drop for MemGuard {
+    fn drop(&mut self) {
+        self.release();
+    }
+}
+
+/// Theoretical bytes of a texture: every mip level, array layer and sample.
+pub(crate) fn texture_bytes(desc: &TextureDescriptor<'_>) -> u64 {
+    let (bw, bh) = desc.format.block_dimensions();
+    let mut total = 0u64;
+    for level in 0..desc.mip_level_count {
+        if let Some(size) = desc.mip_level_size(level) {
+            // Block-compressed formats round up to whole blocks.
+            let size = Extent3d {
+                width: size.width.max(1).div_ceil(bw) * bw,
+                height: size.height.max(1).div_ceil(bh) * bh,
+                depth_or_array_layers: size.depth_or_array_layers.max(1),
+            };
+            total += desc.format.theoretical_memory_footprint(size);
+        }
+    }
+    total * u64::from(desc.sample_count.max(1))
+}
+
+// ---- passes ----------------------------------------------------------------------------------
+
+/// Pass bookkeeping carried by a counted `RenderPass`/`ComputePass`.
+#[derive(Debug, Default)]
+pub(crate) struct PassState {
+    /// Index into this frame's pass list, or `usize::MAX` when not counted.
+    pub(crate) index: usize,
+    pub(crate) topology: PrimitiveTopology,
+    pub(crate) stats_open: bool,
+}
+
+pub(crate) fn begin_render_pass(desc: &RenderPassDescriptor<'_>) -> PassState {
+    if !on() {
+        return PassState { index: usize::MAX, ..Default::default() };
+    }
+    let mut rec = PassRecord { label: desc.label.unwrap_or("").into(), ..Default::default() };
+    let mut size = None;
+    for att in desc.color_attachments.iter().flatten() {
+        rec.color_targets += 1;
+        if size.is_none() {
+            size = Some((att.view.od_size, att.view.texture.descriptor.sample_count));
+        }
+    }
+    if let Some(ds) = &desc.depth_stencil_attachment {
+        rec.depth = true;
+        if size.is_none() {
+            size = Some((ds.view.od_size, ds.view.texture.descriptor.sample_count));
+        }
+    }
+    let ((w, h), samples) = size.unwrap_or(((0, 0), 1));
+    rec.width = w;
+    rec.height = h;
+    rec.samples = samples;
+    C.render_passes.fetch_add(1, Relaxed);
+    C.target_pixels.fetch_add(u64::from(w) * u64::from(h), Relaxed);
+    let mut passes = PASSES.lock().unwrap();
+    passes.push(rec);
+    PassState { index: passes.len() - 1, ..Default::default() }
+}
+
+pub(crate) fn begin_compute_pass(desc: &ComputePassDescriptor<'_>) -> PassState {
+    if !on() {
+        return PassState { index: usize::MAX, ..Default::default() };
+    }
+    C.compute_passes.fetch_add(1, Relaxed);
+    let mut passes = PASSES.lock().unwrap();
+    passes.push(PassRecord { label: desc.label.unwrap_or("").into(), compute: true, ..Default::default() });
+    PassState { index: passes.len() - 1, ..Default::default() }
+}
+
+fn with_pass(state: &PassState, f: impl FnOnce(&mut PassRecord)) {
+    if state.index == usize::MAX {
+        return;
+    }
+    if let Some(p) = PASSES.lock().unwrap().get_mut(state.index) {
+        f(p);
+    }
+}
+
+fn triangles(topology: PrimitiveTopology, n: u64) -> u64 {
+    match topology {
+        PrimitiveTopology::TriangleList => n / 3,
+        PrimitiveTopology::TriangleStrip => n.saturating_sub(2),
+        _ => 0,
+    }
+}
+
+pub(crate) fn direct_draw(state: &PassState, count: u32, instances: u32) {
+    if state.index == usize::MAX {
+        return;
+    }
+    let inst = u64::from(instances);
+    let tris = triangles(state.topology, u64::from(count)) * inst;
+    let nonempty = u64::from(count > 0 && instances > 0);
+    C.draws.fetch_add(1, Relaxed);
+    C.draws_direct.fetch_add(1, Relaxed);
+    C.draws_nonempty.fetch_add(nonempty, Relaxed);
+    C.triangles_direct.fetch_add(tris, Relaxed);
+    C.vertices_direct.fetch_add(u64::from(count) * inst, Relaxed);
+    with_pass(state, |p| {
+        p.draws += 1;
+        p.draws_nonempty += nonempty;
+        p.triangles_direct += tris;
+    });
+}
+
+/// Where an indirect draw's arguments live, so they can be read back after the frame.
+pub(crate) struct IndirectSrc<'a> {
+    pub(crate) buffer: &'a Buffer,
+    pub(crate) offset: BufferAddress,
+    pub(crate) indexed: bool,
+    /// For `*_indirect_count` draws: the buffer and offset of the actual draw count.
+    pub(crate) count: Option<(&'a Buffer, BufferAddress)>,
+}
+
+struct IndirectRec {
+    pass: usize,
+    topology: PrimitiveTopology,
+    buffer: Buffer,
+    offset: BufferAddress,
+    slots: u32,
+    indexed: bool,
+    count: Option<(Buffer, BufferAddress)>,
+}
+
+static INDIRECT: Mutex<Vec<IndirectRec>> = Mutex::new(Vec::new());
+
+pub(crate) fn indirect_draw(state: &PassState, slots: u32, src: Option<IndirectSrc<'_>>) {
+    if state.index == usize::MAX {
+        return;
+    }
+    C.draws.fetch_add(u64::from(slots), Relaxed);
+    C.draws_indirect.fetch_add(u64::from(slots), Relaxed);
+    C.indirect_calls.fetch_add(1, Relaxed);
+    with_pass(state, |p| {
+        p.draws += u64::from(slots);
+        p.draws_indirect += u64::from(slots);
+    });
+    let readable = |b: &Buffer| b.usage().contains(BufferUsages::COPY_SRC);
+    match src {
+        Some(src) if readable(src.buffer) => {
+            let count = src.count.filter(|(b, _)| readable(b)).map(|(b, o)| (b.clone(), o));
+            INDIRECT.lock().unwrap().push(IndirectRec {
+                pass: state.index,
+                topology: state.topology,
+                buffer: src.buffer.clone(),
+                offset: src.offset,
+                slots,
+                indexed: src.indexed,
+                count,
+            });
+        }
+        _ => {
+            C.indirect_unread.fetch_add(u64::from(slots), Relaxed);
+        }
+    }
+}
+
+/// Read back the arguments of this frame's indirect draws (after the GPU wrote them) and count
+/// their triangles and non-empty draws. Call once per frame, after the app's last submit and
+/// before [`take_frame`]. Blocks until the GPU is done. Needs the indirect buffers to have
+/// `COPY_SRC` (Bevy: `RenderDebugFlags::ALLOW_COPIES_FROM_INDIRECT_PARAMETERS`).
+pub fn resolve_indirect_draws(device: &Device, queue: &Queue) {
+    let recs = core::mem::take(&mut *INDIRECT.lock().unwrap());
+    if recs.is_empty() {
+        return;
+    }
+    let stride = |indexed: bool| if indexed { 20u64 } else { 16u64 };
+    // Layout in the read-back buffer: each record's arguments, then its count (4 bytes).
+    let mut offsets = Vec::with_capacity(recs.len());
+    let mut size = 0u64;
+    for r in &recs {
+        let args = u64::from(r.slots) * stride(r.indexed);
+        offsets.push(size);
+        size += args + if r.count.is_some() { 4 } else { 0 };
+    }
+    let size = size.max(4);
+    uncounted(|| {
+        let read = device.create_buffer(&BufferDescriptor {
+            label: Some("od_indirect_read"),
+            size,
+            usage: BufferUsages::COPY_DST | BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        });
+        let mut enc = device.create_command_encoder(&CommandEncoderDescriptor { label: Some("od_indirect_copy") });
+        for (r, &off) in recs.iter().zip(&offsets) {
+            let args = u64::from(r.slots) * stride(r.indexed);
+            if args > 0 {
+                enc.copy_buffer_to_buffer(&r.buffer, r.offset, &read, off, args);
+            }
+            if let Some((cb, co)) = &r.count {
+                enc.copy_buffer_to_buffer(cb, *co, &read, off + args, 4);
+            }
+        }
+        queue.submit([enc.finish()]);
+        let slice = read.slice(..);
+        slice.map_async(MapMode::Read, |r| r.expect("map indirect arguments"));
+        device.poll(PollType::wait_indefinitely()).expect("poll");
+        let data = slice.get_mapped_range();
+        let u32_at = |at: u64| u32::from_le_bytes(data[at as usize..at as usize + 4].try_into().unwrap());
+        let mut passes = PASSES.lock().unwrap();
+        for (r, &off) in recs.iter().zip(&offsets) {
+            let st = stride(r.indexed);
+            let args = u64::from(r.slots) * st;
+            let n = match r.count {
+                Some(_) => u32_at(off + args).min(r.slots),
+                None => r.slots,
+            };
+            let (mut tris, mut nonempty) = (0u64, 0u64);
+            for i in 0..u64::from(n) {
+                let at = off + i * st;
+                // Both layouts start with (vertex or index count, instance count).
+                let (count, instances) = (u32_at(at), u32_at(at + 4));
+                tris += triangles(r.topology, u64::from(count)) * u64::from(instances);
+                nonempty += u64::from(count > 0 && instances > 0);
+            }
+            C.triangles_indirect.fetch_add(tris, Relaxed);
+            C.draws_nonempty.fetch_add(nonempty, Relaxed);
+            if let Some(p) = passes.get_mut(r.pass) {
+                p.triangles_indirect += tris;
+                p.draws_nonempty += nonempty;
+            }
+        }
+        drop(passes);
+        drop(data);
+        read.unmap();
+    });
+}
+
+pub(crate) fn dispatch(state: &PassState) {
+    if state.index == usize::MAX {
+        return;
+    }
+    C.dispatches.fetch_add(1, Relaxed);
+    with_pass(state, |p| p.dispatches += 1);
+}
+
+// ---- GPU pipeline statistics (Vulkan / DX12) -------------------------------------------------
+
+struct Stats {
+    set: QuerySet,
+    resolve: Buffer,
+    read: Buffer,
+    next_slot: u32,
+    /// Slots whose pass reached `Queue::submit`. Only these are resolved: resolving a query
+    /// that never ran would wait forever on Vulkan.
+    submitted: Vec<u32>,
+}
+
+static STATS: Mutex<Option<Stats>> = Mutex::new(None);
+
+/// Each slot is resolved to its own 256-byte-aligned place (wgpu's resolve alignment).
+const SLOT_STRIDE: u64 = QUERY_RESOLVE_BUFFER_ALIGNMENT;
+
+/// Wrap every following render pass in a pipeline-statistics query. Returns false (and does
+/// nothing) when the device lacks `Features::PIPELINE_STATISTICS_QUERY`, as on Metal.
+pub fn install_pipeline_statistics(device: &Device) -> bool {
+    if !device.features().contains(Features::PIPELINE_STATISTICS_QUERY) {
+        return false;
+    }
+    let bytes = u64::from(MAX_STATS_PASSES) * SLOT_STRIDE;
+    let stats = uncounted(|| Stats {
+        set: device.create_query_set(&QuerySetDescriptor {
+            label: Some("od_pipeline_statistics"),
+            ty: QueryType::PipelineStatistics(PipelineStatisticsTypes::all()),
+            count: MAX_STATS_PASSES,
+        }),
+        resolve: device.create_buffer(&BufferDescriptor {
+            label: Some("od_pipeline_statistics_resolve"),
+            size: bytes,
+            usage: BufferUsages::QUERY_RESOLVE | BufferUsages::COPY_SRC,
+            mapped_at_creation: false,
+        }),
+        read: device.create_buffer(&BufferDescriptor {
+            label: Some("od_pipeline_statistics_read"),
+            size: bytes,
+            usage: BufferUsages::COPY_DST | BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        }),
+        next_slot: 0,
+        submitted: Vec::new(),
+    });
+    *STATS.lock().unwrap() = Some(stats);
+    true
+}
+
+/// Called right after a counted render pass begins. Returns the query slot it started, which
+/// the encoder carries to `Queue::submit` (see [`slots_submitted`]).
+pub(crate) fn start_stats(state: &mut PassState, pass: &mut dispatch::DispatchRenderPass) -> Option<u32> {
+    if state.index == usize::MAX {
+        return None;
+    }
+    let mut guard = STATS.lock().unwrap();
+    let stats = guard.as_mut()?;
+    if stats.next_slot >= MAX_STATS_PASSES {
+        return None;
+    }
+    let slot = stats.next_slot;
+    stats.next_slot += 1;
+    pass.begin_pipeline_statistics_query(&stats.set.inner, slot);
+    state.stats_open = true;
+    drop(guard);
+    with_pass(state, |p| p.stats_slot = Some(slot));
+    Some(slot)
+}
+
+/// Called by `Queue::submit` with the query slots of the passes it submitted.
+pub(crate) fn slots_submitted(slots: Vec<u32>) {
+    if slots.is_empty() {
+        return;
+    }
+    if let Some(stats) = STATS.lock().unwrap().as_mut() {
+        stats.submitted.extend(slots);
+    }
+}
+
+/// Resolve this frame's pipeline statistics into the pass list. Call once per frame, after the
+/// app has submitted all of the frame's command buffers. Blocks until the GPU is done.
+pub fn resolve_pipeline_statistics(device: &Device, queue: &Queue) {
+    let mut guard = STATS.lock().unwrap();
+    let Some(stats) = guard.as_mut() else { return };
+    stats.next_slot = 0;
+    let mut slots = core::mem::take(&mut stats.submitted);
+    slots.sort_unstable();
+    slots.dedup();
+    if slots.is_empty() {
+        return;
+    }
+    uncounted(|| {
+        let mut enc = device.create_command_encoder(&CommandEncoderDescriptor { label: Some("od_stats_resolve") });
+        for (k, &slot) in slots.iter().enumerate() {
+            enc.resolve_query_set(&stats.set, slot..slot + 1, &stats.resolve, k as u64 * SLOT_STRIDE);
+        }
+        let used = slots.len() as u64 * SLOT_STRIDE;
+        enc.copy_buffer_to_buffer(&stats.resolve, 0, &stats.read, 0, used);
+        queue.submit([enc.finish()]);
+        let slice = stats.read.slice(0..used);
+        slice.map_async(MapMode::Read, |r| r.expect("map pipeline statistics"));
+        device.poll(PollType::wait_indefinitely()).expect("poll");
+        let mut values = alloc::collections::BTreeMap::new();
+        {
+            let data = slice.get_mapped_range();
+            for (k, &slot) in slots.iter().enumerate() {
+                let at = k * SLOT_STRIDE as usize;
+                let v = |i: usize| u64::from_le_bytes(data[at + i * 8..at + i * 8 + 8].try_into().unwrap());
+                values.insert(slot, [v(0), v(1), v(2), v(3), v(4)]);
+            }
+        }
+        stats.read.unmap();
+        let mut passes = PASSES.lock().unwrap();
+        for p in passes.iter_mut() {
+            if let Some(slot) = p.stats_slot {
+                p.stats = values.get(&slot).copied();
+            }
+        }
+    });
+}
